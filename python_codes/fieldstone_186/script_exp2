#! /bin/bash

rm opla

for res in 32 64 96; do 

    for f in 4 6 8 10 15 20 30 40; do

        echo $res $f 

        python3 stone.py $res $f > opla
        mv solution.vtu solution_${res}_${f}.vtu
        mv top_solution.ascii top_solution_${res}_${f}.ascii 
        mv circle_solution.ascii circle_solution_${res}_${f}.ascii 

    done

done
