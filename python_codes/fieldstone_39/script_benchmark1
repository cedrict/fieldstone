        python3 stone.py $nelx 1 30 30 $niter 0 25 $meth > opla
    done

    for meth in U C M ; do
        echo nelx= $nelx etam= 18 method= $meth
        python3 stone.py $nelx 1  0  0 $niter 18 25 $meth > opla
