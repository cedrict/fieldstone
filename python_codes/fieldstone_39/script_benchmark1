        python3 stone.py $nelx 1 30  0 $niter 19 25 $meth > opla
        python3 stone.py $nelx 1 30 30 $niter 19 25 $meth > opla
    done

    for meth in U C M ; do
        echo nelx= $nelx etam= 20 method= $meth
