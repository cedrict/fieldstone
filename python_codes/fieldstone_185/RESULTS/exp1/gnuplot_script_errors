#
set term pdf enhanced font "Times,12pt"
set grid
set xlabel 'h_x=h_y'
set pointsize .4
set log x
set key outside

###########################################################

set output 'u_stats.pdf'
set ylabel 'u (min/max)'
plot[5e-3:][]\
'u_stats_1em6.ascii' u 7:4 w lp lt 1 t 'CG tol = 1e-6',\
'u_stats_1em6.ascii' u 7:5 w lp lt 1 notitle,\
'u_stats_1em8.ascii' u 7:4 w lp lt 2 t 'CG tol = 1e-8',\
'u_stats_1em8.ascii' u 7:5 w lp lt 2 notitle,\

set output 'v_stats.pdf'
set ylabel 'v (min/max)'
plot[5e-3:][]\
'v_stats_1em6.ascii' u 7:4 w lp lt 1 t 'CG tol = 1e-6',\
'v_stats_1em6.ascii' u 7:5 w lp lt 1 notitle,\
'v_stats_1em8.ascii' u 7:4 w lp lt 2 t 'CG tol = 1e-8',\
'v_stats_1em8.ascii' u 7:5 w lp lt 2 notitle,\

set output 'w_stats.pdf'
set ylabel 'w (min/max)'
plot[5e-3:][]\
'w_stats_1em6.ascii' u 7:4 w lp lt 1 t 'CG tol = 1e-6',\
'w_stats_1em6.ascii' u 7:5 w lp lt 1 notitle,\
'w_stats_1em8.ascii' u 7:4 w lp lt 2 t 'CG tol = 1e-8',\
'w_stats_1em8.ascii' u 7:5 w lp lt 2 notitle,\

###########################################################

set ylabel 'd_{rms}'
set output 'drms.pdf'
plot[5e-3:][]\
'errors_1em6.ascii' u 7:3 w lp t 'CG tol = 1e-6',\
'errors_1em8.ascii' u 7:3 w lp t 'CG tol = 1e-8',\

###########################################################

set log y 
set ylabel '|u-u_{th}|_2'
set output 'erru.pdf'
plot[5e-3:][]\
'errors_1em6.ascii' u 7:5 w lp t 'CG tol = 1e-6',\
'errors_1em8.ascii' u 7:5 w lp t 'CG tol = 1e-8',\
2e-6*x**2 lt -1 dt 2 t 'h^2'

