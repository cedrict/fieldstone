set ylabel 'd_{rms}'
set output 'drms.pdf'
plot[5e-3:][]\
'errors.ascii'  u 7:3 w lp notitle

###################################

set log y 
set ylabel '|u-u_{th}|_2'
set output 'erru.pdf'
plot[5e-3:][]\
'errors.ascii'  u 7:5 w lp notitle,\
2e-6*x**2 lt -1 dt 2 t 'h^2'

