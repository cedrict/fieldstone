set term pdf enhanced font "Times,12pt"
set grid
set xlabel 'h_x=h_y'
set pointsize .4
set log x



set output 'u_stats.pdf'
set ylabel 'u (min/max)'
plot[5e-3:][]\
'u_stats.ascii' u 7:4 w lp notitle,\
'u_stats.ascii' u 7:5 w lp notitle

set output 'v_stats.pdf'
set ylabel 'v (min/max)'
plot[5e-3:][]\
'v_stats.ascii' u 7:4 w lp notitle,\
'v_stats.ascii' u 7:5 w lp notitle

set output 'w_stats.pdf'
set ylabel 'w (min/max)'
plot[5e-3:][]\
'w_stats.ascii' u 7:4 w lp notitle,\
'w_stats.ascii' u 7:5 w lp notitle

