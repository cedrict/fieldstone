#
set term pdf enhanced font "Times,12pt"
set grid
set pointsize 0.3

kyear=365.25*24*3600*1000

######################################################

set key bottom

set xlabel 'time (kyr)'
set ylabel  'topography (m)'
set output 'topography.pdf'
plot[:250][]\
'elevation.ascii' u ($1/kyear):2 w lp lt 1 t 'min',\
'elevation.ascii' u ($1/kyear):3 w lp lt 2 t 'max',\
"aspect/UNDERWORLD_fs.dat" using ($1*1000):2 t 'UNDERWORLD', \
"aspect/MILAMIN_fs.dat" using ($1):2 t 'MILAMIN', \
"aspect/SULEC_fs.dat" using ($1*1000):2 t 'SULEC', \
"aspect/statistics" using ($2/1.e3):15 t 'ASPECT',\
"aspect/statistics" using ($2/1.e3):16 t 'ASPECT',\



######################################################

#pref=(600e3*3300+100e3*3200)*10
pref=700e3*3300*10

set key bottom
set output 'pressures.pdf'
set ylabel 'pressure (MPa)'
plot[][:]\
'measurements.ascii' u ($1/kyear):(-($3-pref)/1e6) w lp t '|p-p_{ref}|, 140x70',\
'elevation.ascii' u ($1/kyear):($3*10*3300/1e6) w lp t 'p_{topography}, 140x70' 

######################################################

year=365.25*3600*24
cm=0.01

set output 'top_velocity.pdf'
set ylabel 'velocity (cm/year)'
plot[][:]\
'measurements.ascii' u ($1/kyear):($2/cm*year) w lp t '140x70'

######################################################

set output 'blob_vy.pdf'
set ylabel 'average vertical velocity (cm/yr)'
plot[][:]\
'measurements.ascii' u ($1/kyear):($5/cm*year) w lp t '140x70'

######################################################

area=pi*50e3**2/2

set output 'blob_volume.pdf'
set ylabel 'relative blob volume error'
plot[][:]\
'measurements.ascii' u ($1/kyear):(($6-area)/area) w lp t '140x70'


