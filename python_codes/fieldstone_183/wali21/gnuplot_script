#gnuplot 

set term pdf enhanced font "Times,12pt"
set grid
set key outside
set ylabel 'z (km)'

set ytics 100
##################################################
set xlabel 'T (K)'

set output 'T.pdf'
plot[][5370:6370]\
'T_50.ascii'  u 2:($1/1e3) w l t 'age=050Myr',\
'T_80.ascii'  u 2:($1/1e3) w l t 'age=080Myr',\
'T_100.ascii' u 2:($1/1e3) w l t 'age=100Myr',\
'T_200.ascii' u 2:($1/1e3) w l t 'age=200Myr',\
6250 lt -1 dt 2

##################################################
