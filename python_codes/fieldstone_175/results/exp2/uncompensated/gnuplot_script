#
set term pdf enhanced font "Times,12pt"
set grid
set key outside
set xlabel 'x'
set pointsize .4
L=2.
delta=L/8

#u
f(x) = x<L/2-delta ? -delta/2 : x<L/2+delta ? 0.5*( x-L/2 + delta/pi * sin  (pi*(x-L/2)/delta) ) : delta/2

#dudx
g(x) =x<L/2-delta ? 0  : x<L/2+delta ?  0.5*(1+cos( pi*(x-L/2)/delta ))  : 0


################################################################


set ylabel 'p'
set output 'p.pdf'
plot[][]\
'solution_64.ascii' u 1:5 t 'nelx=64' w p,\
4./3.*g(x) t '4/3*dud/dx',\
0 lt -1 t 'analytical' 


##########################################################

Lx=2
set xlabel 'h'
set ylabel 'L_2 error'

set log xy 
set output 'errors.pdf'
plot[][]\
'errors.ascii' u (Lx/$3):6 w lp t 'velocity',\
'errors.ascii' u (Lx/$3):9 w lp t 'pressure',\
x**3/10 lt -1 dt 2 t 'h^3',\
x**2*1 lt -1 dt 3 t 'h^2'



